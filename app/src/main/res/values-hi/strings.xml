    <string name="help_title">सहायता</string>
    <string name="help_section_places">स्थान और पसंदीदा</string>
    <string name="help_q_search">किसी दूसरे स्थान का मौसम कैसे देखें?</string>
    <string name="help_a_search">ऊपर आवर्धक लेंस पर टैप करें। कोई शहर, पिन कोड, निर्देशांक या Plus Code लिखें, फिर किसी परिणाम पर टैप करें। उस स्थान का मौसम 12 घंटे तक दिखता है। उसके बाद ऐप आपके वर्तमान स्थान पर लौट आता है।</string>
    <string name="help_q_favorite_add">पसंदीदा स्थान कैसे सहेजें?</string>
    <string name="help_a_favorite_add">जब खोजा गया स्थान दिख रहा हो, ऊपर खाली दिल पर टैप करें। तब ऐप उस स्थान को रख लेता है। यदि ऐप को आपके स्थान की अनुमति नहीं है, तो आपका चुना हुआ स्थान सीधे सहेजा जाता है।</string>
    <string name="help_q_favorite_move">अपने पसंदीदा स्थानों के बीच कैसे जाएँ?</string>
    <string name="help_a_favorite_move">बाएँ या दाएँ स्वाइप करें, या स्थान के नाम के नीचे तीरों पर टैप करें। हर बिंदु एक स्थान है, और पहला बिंदु आपका वर्तमान स्थान है। अपने स्थानों की सूची देखने और एक चुनने के लिए किसी तीर को दबाकर रखें।</string>
    <string name="help_q_favorite_edit">पसंदीदा स्थान का नाम कैसे बदलें या उसे कैसे हटाएँ?</string>
    <string name="help_a_favorite_edit">नाम बदलने के लिए ऊपर उसके नाम को दबाकर रखें। हटाने के लिए भरे हुए दिल पर टैप करें। अपने वर्तमान स्थान पर लौटने के लिए पिन पर टैप करें।</string>
    <string name="help_q_place_details">निर्देशांक कैसे देखें या कॉपी करें?</string>
    <string name="help_a_place_details">क्षेत्र और देश के आगे ग्रिड आइकन पर टैप करें। एक कार्ड स्थान, निर्देशांक और Plus Code दिखाता है। स्थान को मानचित्र में खोलने के लिए किसी पंक्ति पर टैप करें। कॉपी करने के लिए किसी पंक्ति को दबाकर रखें।</string>
    <string name="help_section_display">भाषा, फ़ॉन्ट और इकाइयाँ</string>
    <string name="help_q_language">भाषा कैसे बदलें?</string>
    <string name="help_a_language">स्क्रीन के नीचे झंडे पर टैप करें। हर टैप अगली भाषा दिखाता है: मालागासी, अरबी, अंग्रेज़ी, स्पेनिश, फ़्रेंच, हिंदी, नेपाली और चीनी।</string>
    <string name="help_q_font">फ़ॉन्ट कैसे बदलें?</string>
    <string name="help_a_font">स्क्रीन के नीचे फ़ॉन्ट के नाम पर टैप करें। हर टैप अगली फ़ॉन्ट जोड़ी दिखाता है।</string>
    <string name="help_q_units">इकाइयाँ कैसे बदलें?</string>
