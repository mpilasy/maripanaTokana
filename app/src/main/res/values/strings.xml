    <string name="help_title">Help</string>
    <string name="help_section_places">Places and favorites</string>
    <string name="help_q_search">How do I see the weather for another place?</string>
    <string name="help_a_search">Tap the magnifying glass at the top. Type a city, a postal code, coordinates or a Plus Code, then tap a result. The weather for that place shows for 12 hours. Then the app goes back to your current location.</string>
    <string name="help_q_favorite_add">How do I save a favorite?</string>
    <string name="help_a_favorite_add">While a searched place shows, tap the empty heart at the top. The app then keeps the place. If the app has no access to your location, a place that you pick is saved directly.</string>
    <string name="help_q_favorite_move">How do I move between my favorites?</string>
    <string name="help_a_favorite_move">Tap the place name, or the arrow before it, to see the list of your places: your current location first, then your favorites. Tap one to go to it.</string>
    <string name="help_q_favorite_edit">How do I rename or remove a favorite?</string>
    <string name="help_a_favorite_edit">To rename a favorite, hold its name at the top. To remove it, tap the full heart. To go back to your current location, tap the pin.</string>
    <string name="help_q_place_details">How do I see or copy the coordinates?</string>
    <string name="help_a_place_details">Tap the grid icon in front of the region and country. A card shows the place, the coordinates and the Plus Code. Tap a line to open the place in a map. Hold a line to copy it.</string>
    <string name="help_section_display">Language, font and units</string>
    <string name="help_q_language">How do I change the language?</string>
    <string name="help_a_language">Tap the flag at the bottom of the screen. Each tap shows the next language: Malagasy, Arabic, English, Spanish, French, Hindi, Nepali and Chinese.</string>
    <string name="help_q_font">How do I change the font?</string>
    <string name="help_a_font">Tap the font name at the bottom of the screen. Each tap shows the next font pair.</string>
    <string name="help_q_units">How do I change the units?</string>
    <string name="help_a_units">Each value shows metric and imperial units. Tap a value to put the other unit first.</string>
    <string name="help_section_weather">Weather data</string>
    <string name="help_q_refresh">How do I get new weather data?</string>
    <string name="help_a_refresh">Pull the screen down, or tap the update time under the place name.</string>
    <string name="help_q_cut_title">A card title is cut short. How do I read all of it?</string>
    <string name="help_a_cut_title">Hold the title. The full title then shows.</string>
    <string name="help_q_share">How do I share the weather?</string>
    <string name="help_a_share">Tap the share button on a card.</string>
