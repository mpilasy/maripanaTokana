:80 {
	encode gzip

	# Backwards compatibility: redirect old /svelte path to /
	redir /svelte / 301
	redir /svelte/ / 301

	root * /srv/app
	try_files {path} /index.html
	file_server

	# Disable all caching for debugging
	header Cache-Control "no-cache, no-store, must-revalidate"
	header Pragma "no-cache"
	header Expires "0"
}
